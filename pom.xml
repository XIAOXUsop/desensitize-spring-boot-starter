<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xiaoxu</groupId>
    <artifactId>desensitize-spring-boot-starter</artifactId>
    <version>0.6.2</version>
    <packaging>jar</packaging>

    <name>desensitize-spring-boot-starter</name>
    <description>注解式敏感数据脱敏 Spring Boot Starter（展示态，Jackson 序列化层）</description>
    <url>https://github.com/XIAOXUsop/desensitize-spring-boot-starter</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>XIAOXUsop</id>
            <name>XIAOXUsop</name>
            <url>https://github.com/XIAOXUsop</url>
        </developer>
    </developers>

    <!-- Central 要求 SCM 指向可访问的仓库；tag 与 POM 版本一致才能通过校验 -->
    <scm>
        <connection>scm:git:https://github.com/XIAOXUsop/desensitize-spring-boot-starter.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/XIAOXUsop/desensitize-spring-boot-starter.git</developerConnection>
        <url>https://github.com/XIAOXUsop/desensitize-spring-boot-starter</url>
        <tag>v${project.version}</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.13</spring-boot.version>
        <!--
          可复现构建。**这不是洁癖，是这个库能不能被验证的前提。**

          这个仓库发布 jar 到 GitHub Release。如果不固定时间戳，jar 里每个条目的
          时间就是"构建那一刻"，于是同一份源码在任何两个时刻构建出的字节都不同——
          「你下载到的这个 jar 是不是从这份源码构建出来的」这个问题就**无法用哈希回答**。

          实测过一次（2026-09-19，还没加这个属性时）：
            已发布 v0.6.1 的 jar 与本地构建的 jar，条目列表完全相同，
            但 `META-INF/LICENSE` 一个 1066 字节、一个 1087 字节，
            差的 21 字节正是 21 个 CRLF——工作区检出的行尾进了产物。

          那个具体问题由 `.gitattributes` + 重新检出解决（见该文件里的说明）。
          这个属性解决的是另一半：**时间戳**。设成一个固定值之后，
          给定同一份源码与同一个 Maven 版本，产物字节相同。

          代价：jar 里的时间戳不再反映真实构建时间。对可验证性是划算的。
          发版时不需要改它——改了反而会让"同一份源码"产出两种字节。
        -->
        <project.build.outputTimestamp>2026-09-19T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              jackson-bom 必须排在 spring-boot-dependencies **前面**：
              多个 import 管理同一个坐标时，**先声明的那份赢**。

              为什么非钉不可（2026-09-19 实测）：
              本库不写 jackson 的版本号，版本由内嵌 POM import 的 spring-boot-dependencies
              决定。而按 README「方式一」装出来的空工程里，实测解析结果是
              **jackson-databind 2.21.2**——它命中下面五条公告的**全部**：

                CVE-2026-54512 (HIGH)   patched 2.21.4
                CVE-2026-54513 (HIGH)   patched 2.21.4
                CVE-2026-54514 (MEDIUM) patched 2.21.4
                CVE-2026-59888 (MEDIUM) patched 2.21.4
                CVE-2026-54515 (MEDIUM) patched 2.21.5

              也就是说，**照文档装这个 starter 的人会拿到一个带 5 条已知漏洞的 Jackson**。

              只把 spring-boot 升上去**解决不了**：3.5.13 的 BOM 给 2.21.2，
              目前最新的 3.5.16 给 2.21.4——仍然命中 CVE-2026-54515。
              修复线是 2.21.5，没有任何一个 3.5.x 的 BOM 会给到这个版本，只能显式钉。
              （姊妹项目 mcp-sentinel / ctxpress 也都取 2.21.5，理由同：五条里要求最高的那条。）

              这个库的定位是"序列化层脱敏"，钉住自己唯一关心的那个序列化库的版本，
              比让它跟着宿主 BOM 漂移更说得通。
            -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ApplicationContextRunner：验证自动配置在真实上下文中生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ApplicationContextRunner 的 AssertProvider 需要 AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!--
              把 LICENSE 打进 jar 的 META-INF。
              Maven 默认不这么做，于是发布的产物里就没有许可证文本——
              一个可自由再分发的 jar 必须自带它的许可条件。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-license-into-jar</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          发布到 Maven Central 用的 profile。**默认不参与构建**：
          签名需要 GPG 私钥，源码 / Javadoc jar 也会拖慢日常迭代。

          用法：mvn -Prelease -DskipTests deploy
          凭据来自 settings.xml 里 id=central 的 server（Sonatype 用户令牌）。
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <!--
                          刻意不用 3.6+：那些版本要求 Maven ≥ 3.6.3，而**使用者**可能
                          用的是自己装的旧 Maven。3.5.0 在 Maven 3.3.9 与 CI 的现代
                          Maven 上都能跑。

                          （这句原先还写着「本仓库没有 Maven Wrapper（ctxpress / amlagent
                           有）」——**那是错的**，wrapper 早就在仓库里。留着 3.5.0 的真实
                           理由只剩"消费者侧可能更旧"这一条。）
                        -->
                        <version>3.5.0</version>
                        <configuration>
                            <!-- 注释里有中文与代码片段，doclint 的严格模式会让发布卡在文档格式上 -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <!-- 显式给源级别：不写的话 javadoc 会退回默认的 8，
                                 于是在 switch 表达式上直接报错 -->
                            <source>21</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- 先传到 Portal 停在待发布状态，确认无误再点发布 -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>